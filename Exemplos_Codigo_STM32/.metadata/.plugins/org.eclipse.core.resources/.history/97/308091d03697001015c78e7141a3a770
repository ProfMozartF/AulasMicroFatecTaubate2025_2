void lerBotao(Button_t *btn) {
    uint8_t estadoAtual = HAL_GPIO_ReadPin(btn->port, btn->pin);
    uint32_t now = HAL_GetTick();

    // Reset dos eventos
    btn->pressionado = 0;
    btn->solto = 0;

    if (estadoAtual != btn->raw_state) {
        // mudança detectada, reinicia timer
        btn->raw_state = current_state;
        btn->last_change_time = now;
    }

    // Confirma mudança apenas se passou o tempo de debounce
    if ((now - btn->last_change_time) >= btn->debounce_time)
    {
			if (btn->ultimoEstadoEstavel != btn->raw_state)
			{
				btn->ultimoEstadoEstavel = btn->raw_state;

							if (btn->ultimoEstadoEstavel == GPIO_PIN_RESET)
								{ // Botão pressionado (pull-up típico)
									btn->pressionado = 1;
									btn->press_time = now;
								}
					else
						{
						btn->solto = 1;
						}
			}
    }
}
//**************************************************************************************************************************
void Button_Init(Button_t *btn, GPIO_TypeDef *port, uint16_t pin, uint32_t debounce_ms) {
    btn->port = port;
    btn->pin = pin;
    btn->debounce_time = debounce_ms;
    btn->ultimoEstadoEstavel = HAL_GPIO_ReadPin(port, pin);
    btn->raw_state = btn->stable_state;
    btn->last_change_time = HAL_GetTick();
    btn->pressionado = 0;
    btn->solto = 0;
    btn->press_time = 0;
}
