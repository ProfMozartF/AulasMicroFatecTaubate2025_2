/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  HAL_ADCEx_Calibration_Start(&hadc1);
  // Inicia o ADC no Modo DMA para multiplos canais
  HAL_ADC_Start_DMA(&hadc1, ADCBuffer, 2);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);

  Ref_PWM=100;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  //************ PEDAL 1 *******************
	  pedal1_raw = ADCBuffer[0];
	  Saida_IIR = alpha*(float)ADCBuffer[0]+(1-alpha)*saida_ant;
	  saida_ant = Saida_IIR;
	  pedal1_filt = (uint16_t)(Saida_IIR);
	  volt_Pedal1 = pedal1_raw*(5/4095);

	  //************ PEDAL 2 *******************
	  pedal2_raw = ADCBuffer[1];
	  Saida_IIR = alpha*(float)ADCBuffer[1]+(1-alpha)*saida_ant2;
	  saida_ant2 = Saida_IIR;
	  pedal2_filt = (uint16_t)(Saida_IIR);
	  volt_Pedal2 = pedal2_filt*(5/4095);

	  //************* REDEUNDANCIA E PWM **************
	  delta_pedal = volt_Pedal2-volt_Pedal1;
	  if((delta_pedal>1.8)&&(delta_pedal<2.2))
	  {
		  //volt_Pedal1 0.5 até 2 volts
		  Ref_PWM = ((pedal1_filt*(5000/4095))-500)*0.666;
	  }
	  TIM1->CCR1 = Ref_PWM; //Atualiza o valor do comparador

	 //************* ESCREVE NA UART ***********************
	  sprintf(mensagem, "VOLT PEDAL 1 = %.2f\r\n",volt_Pedal1);
	  HAL_UART_Transmit(&huart1, (uint8_t*)mensagem, strlen(mensagem), 50);
	  sprintf(mensagem, "VOLT PEDAL 2 = %.2f\r\n",volt_Pedal2);
	  HAL_UART_Transmit(&huart1, (uint8_t*)mensagem, strlen(mensagem), 50);
	  sprintf(mensagem, "VALOR PWM = %d\r\n",Ref_PWM);
	  HAL_UART_Transmit(&huart1, (uint8_t*)mensagem, strlen(mensagem), 50);

	  HAL_Delay(200);

  }
  /* USER CODE END 3 */
}

